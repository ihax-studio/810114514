  <script>
    // テーブル拡大アニメ
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        document.getElementById('mainTableWrap').style.transform = "scale(1)";
      }, 150);
    });

    // 荒川工科高校セルアニメ＋遷移
    const arakawaCell = document.getElementById('arakawaCell');
    arakawaCell.addEventListener('click', function(){
      if(arakawaCell.classList.contains('fading')) return;
      arakawaCell.classList.add('fading');
      setTimeout(()=>{ location.href = 'https://app.com'; }, 700);
    });

    // ===== k画像押下時「毎回0.8→1へ0.5s拡大」JSで確実に実行（opacity使わず） =====
    const kImage = document.getElementById('kImage');
    let resetTimer = null, isDown = false;
    const originalSrc = 'img.png';
    const clickSrc = 'clickbefore.png';

    kImage.addEventListener('pointerdown', e => {
      if(resetTimer) clearTimeout(resetTimer);
      isDown = true;
      // clickbefore.pngに切替
      kImage.src = clickSrc;
      // フェード中なら解除
      kImage.classList.remove('fadingOut');
      // 一度transition解除してscale0.8に即座にセット
      kImage.style.transition = 'none';
      kImage.style.transform = 'scale(0.8)';
      // 強制リフロー
      void kImage.offsetWidth;
      // 0.5sトランジションを戻して1へ拡大
      kImage.style.transition = 'transform 0.5s cubic-bezier(.8,0,.2,1)';
      kImage.style.transform = 'scale(1)';
    });

    // pointerup/leaveで縮小フェード後リセット
    function fadeOutAndReset() {
      if(!isDown) return;
      isDown = false;
      // 縮小＋ブラー（opacity無し）
      kImage.classList.add('fadingOut');
      kImage.style.transition = 'transform 0.3s, filter 0.3s cubic-bezier(.8,0,.2,1)';
      kImage.style.transform = 'scale(0.8)';
      kImage.style.filter = 'brightness(1.7) blur(12px)';
      resetTimer = setTimeout(() => {
        kImage.classList.remove('fadingOut');
        kImage.src = originalSrc;
        kImage.style.filter = '';
        kImage.style.transform = 'scale(1)';
        kImage.style.transition = 'transform 0.5s cubic-bezier(.8,0,.2,1), filter 0.3s cubic-bezier(.8,0,.2,1)';
      }, 300);
    }
    kImage.addEventListener('pointerup', fadeOutAndReset);
    kImage.addEventListener('pointerleave', fadeOutAndReset);
    kImage.addEventListener('pointercancel', fadeOutAndReset);

    // ===== どのtd押してもmac.mp3再生：連打・長押し可 =====
    function playMacSound() {
      const se = new Audio('mac.mp3');
      se.play();
    }
    document.querySelectorAll('td').forEach(td => {
      td.addEventListener('mousedown', playMacSound);
      td.addEventListener('touchstart', playMacSound, {passive:true});
    });

    // ===== 住所セル: Google Mapオーバーレイ =====
    const addressCell = document.getElementById('addressCell');
    const mapOverlay  = document.getElementById('addressMapOverlay');
    function showMap(e) {
      e && e.preventDefault();
      mapOverlay.style.display = 'block';
      mapOverlay.classList.remove('hiding');
      setTimeout(() => {
        mapOverlay.classList.add('showing');
      }, 10);
    }
    function hideMap(e) {
      e && e.preventDefault();
      mapOverlay.classList.remove('showing');
      mapOverlay.classList.add('hiding');
      setTimeout(() => {
        mapOverlay.classList.remove('hiding');
        mapOverlay.style.display = 'none';
      }, 440);
    }
    addressCell.addEventListener('mousedown', showMap);
    addressCell.addEventListener('touchstart', showMap, {passive:false});
    addressCell.addEventListener('mouseup', hideMap);
    addressCell.addEventListener('mouseleave', hideMap);
    addressCell.addEventListener('touchend', hideMap, {passive:false});
    addressCell.addEventListener('touchcancel', hideMap, {passive:false});
    mapOverlay.addEventListener('mousedown', e=>e.stopPropagation());
    mapOverlay.addEventListener('touchstart', e=>e.stopPropagation());
  </script>
  
<script>window.addEventListener('DOMContentLoaded', () => {
  const body = document.body;

  // 背景だけを載せるレイヤー
  const bgLayer = document.createElement('div');
  bgLayer.style.position = 'fixed';
  bgLayer.style.top = 0;
  bgLayer.style.left = 0;
  bgLayer.style.width = '100vw';
  bgLayer.style.height = '100vh';
  bgLayer.style.zIndex = -1;
  bgLayer.style.pointerEvents = 'none';
  bgLayer.style.backgroundBlendMode = 'screen';
  body.style.background = 'none';
  body.style.backgroundColor = 'transparent';
  body.appendChild(bgLayer);

  let hue = 0;

  function getGradientsByWidth() {
    const isPC = window.matchMedia('(min-width: 920px)').matches;
    hue = (hue + 1) % 360;

    if (isPC) {
      // WWDC25ロゴ風、hue回転で多色グラデーション
      const c1 = `hsl(${(hue + 120) % 360}, 100%, 60%)`; // 緑
      const c2 = `hsl(${(hue + 60) % 360}, 100%, 60%)`;  // 黄
      const c3 = `hsl(${(hue + 30) % 360}, 100%, 60%)`;  // オレンジ
      const c4 = `hsl(${(hue + 330) % 360}, 100%, 65%)`; // ピンク
      const c5 = `hsl(${(hue + 260) % 360}, 100%, 65%)`; // 紫
      const c6 = `hsl(${(hue + 210) % 360}, 100%, 65%)`; // 青
      const c7 = `hsl(${(hue + 190) % 360}, 100%, 65%)`; // 水色

      bgLayer.style.background = `
        radial-gradient(at 46% 54%, ${c1} 0px, transparent 50%),
        radial-gradient(at 30% 94%, ${c2} 0px, transparent 50%),
        radial-gradient(at 90% 5%, ${c3} 0px, transparent 50%),
        radial-gradient(at 24% 60%, ${c4} 0px, transparent 50%),
        radial-gradient(at 64% 7%, ${c5} 0px, transparent 50%),
        radial-gradient(at 63% 5%, ${c6} 0px, transparent 50%),
        radial-gradient(at 6% 40%, ${c7} 0px, transparent 50%)
      `;
      bgLayer.style.backgroundColor = '#ffffff00';
    } else {
      // スマホ用グラデーション（今まで通り、色も変えない）
      const c1 = `hsl(${hue}, 100%, 65%)`;
      const c2 = `hsl(${(hue + 90) % 360}, 100%, 60%)`;
      const c3 = `hsl(${(hue + 180) % 360}, 100%, 50%)`;
      const c4 = `hsl(${(hue + 270) % 360}, 100%, 70%)`;
      const c5 = `hsl(${(hue + 45) % 360}, 100%, 55%)`;

      bgLayer.style.background = `
        radial-gradient(circle at 30% 70%, ${c1}, transparent 60%),
        radial-gradient(circle at 60% 30%, ${c2}, transparent 60%),
        radial-gradient(circle at 90% 80%, ${c3}, transparent 60%),
        radial-gradient(circle at 10% 20%, ${c4}, transparent 60%),
        radial-gradient(circle at 50% 50%, ${c5}, transparent 70%)
      `;
      bgLayer.style.backgroundColor = '#ffffff30';
    }
  }

  function animate() {
    getGradientsByWidth();
    requestAnimationFrame(animate);
  }

  animate();
});

</script>

